# ================================
# CONFIGURACIÓN DEL SERVIDOR
# ================================
PORT=3000                      # Puerto en el que correrá la aplicación (ej: 3000, 3001)

# ================================
# API DE INTELLISCREEN
# ================================
INTELLISCREEN_API_KEY=         # Tu API Key de Intelliscreen (obligatorio)

# ================================
# CONFIGURACIÓN DE WHATSAPP (WAHA)
# ================================
WAHA_URL=                       # URL del worker de WAHA (ej: https://worker.waha.com)
WAHA_PHONE=                      # Número de teléfono registrado en WAHA (ej: +5215512345678)
WAHA_TOKEN=                      # Token de WAHA (el mismo que usas para iniciar sesión en el dashboard)
WHATSAPP_CHAT_ID=                # ID del chat de WhatsApp al que se enviarán los mensajes

# ================================
# CONFIGURACIÓN DE TELEGRAM
# ================================
TELEGRAM_BOT_TOKEN=              # Token de tu bot de Telegram (obligatorio)
TELEGRAM_CHAT_ID=                # Chat ID de Telegram donde se enviarán los mensajes

# ================================
# OPCIONES ADICIONALES
# ================================
LOG_LEVEL=info                   # Nivel de logs (debug, info, warn, error)
USE_ESCAPING_MARKDOWN=true       # Escapar caracteres especiales de Markdown para Telegram (true/false)
